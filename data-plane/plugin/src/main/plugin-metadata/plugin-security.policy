grant {
  // The store backend is a jar an operator drops beside this one, and it talks to etcd, ZooKeeper or
  // whatever else over the network. Nothing in this repository names one — D6.2 — so nothing here can
  // narrow the permission to a known host or port either. The scope is the store URI's, and it is
  // enforced by which backend jar is installed rather than by this file.
  permission java.net.SocketPermission "*", "connect,resolve";

  // ServiceLoader finds a backend on the plugin's own classloader, and gRPC and Curator both set the
  // context classloader while starting their client threads.
  permission java.lang.RuntimePermission "*", "setContextClassLoader";

  // The filesystem backend, which store-api bundles, reads and writes an ordinary directory. Which one is
  // configuration, so the grant cannot name it.
  permission java.io.FilePermission "<<ALL FILES>>", "read,write,delete";
};
